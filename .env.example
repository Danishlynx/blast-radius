# Blast Radius configuration. Copy to .env and fill in.
# `make up` + `scripts/bootstrap_token.py` fill DATAHUB_TOKEN automatically.

# --- DataHub ---
DATAHUB_GMS_URL=http://localhost:8080
# Personal access token. Auto-minted by `make up` (via scripts/bootstrap_token.py);
# or generate manually in the UI: Settings -> Access Tokens.
DATAHUB_TOKEN=
# Demo-stack signing material (>=32 bytes each; defaults baked into docker-compose.yml).
# Override only if you want your own:
# DATAHUB_TOKEN_SERVICE_SIGNING_KEY=
# DATAHUB_TOKEN_SERVICE_SALT=

# --- LLM (agent runtime, Day 2+) ---
# anthropic | ollama
LLM_PROVIDER=anthropic
# Opus 4.8: the agent makes few, small, correctness-critical calls, so the
# top Opus tier costs ~$0.35 per full demo run. (With ollama, set a local
# model name instead, e.g. llama3.1.)
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- GitHub (fix PRs, Day 5) ---
# Fine-grained PAT scoped to the single demo repo: contents + pull-requests only.
GITHUB_TOKEN=
GITHUB_REPO=

# --- Slack (owner alerts; console fallback when unset) ---
SLACK_WEBHOOK_URL=

# --- Agent behavior ---
# Comma-separated dataset URNs to watch; seeded by `make ingest`.
WATCHLIST=
POLL_INTERVAL_S=15
# Severities that require human approval before acting (empty = auto-act, demo default).
APPROVAL_REQUIRED_SEVERITIES=
MAX_TOOL_CALLS=25

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
